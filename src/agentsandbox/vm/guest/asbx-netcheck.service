[Unit]
Description=agentsandbox fail-closed verification
# multi-user.target does not wait on cloud-final.service, so without this the
# [Install] WantedBy below can race bootstrap.sh's own runcmd invocation:
# this unit's own Wants=wg-quick@wg0.service pulls the tunnel up, then checks
# nftables before bootstrap.sh has had a chance to load the real ruleset (its
# job, not any unit's), sees "tunnel up, nftables empty" and - correctly, by
# its own fail-closed logic - powers the guest off. Ordering after cloud-final
# means this early auto-start only ever runs once bootstrap.sh already has.
After=wg-quick@wg0.service nftables.service cloud-final.service
Wants=wg-quick@wg0.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/asbx-netcheck
# If the guest is ever not fail-closed, it stops being a guest - unless the
# session was started with --netcheck warn, which keeps it up for debugging.
ExecStopPost=/bin/sh -c 'test "$EXIT_STATUS" = "0" || ! grep -q halt /etc/asbx/netcheck-mode || systemctl poweroff'

[Install]
WantedBy=multi-user.target
